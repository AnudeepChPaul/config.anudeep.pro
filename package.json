{
  "name": "@config/src",
  "version": "0.1.0",
  "description": "Git-backed config registry for anudeep.pro — one place every service reads its configuration from",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24.20.0"
  },
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "announce": "tsx --conditions=development scripts/announce.ts",
    "eta:compile": "pnpm announce eta:compile && tsx --conditions=development scripts/compile-eta.ts",
    "eta:watch": "pnpm announce eta:watch && tsx --conditions=development scripts/compile-eta.ts --watch",
    "dev": "pnpm announce dev && tsx --conditions=development scripts/compile-eta.ts --watch-and-server",
    "prebuild": "pnpm announce prebuild && pnpm eta:compile",
    "build": "pnpm announce build && tsc -p tsconfig.build.json --pretty --extendedDiagnostics --listFiles --verbose",
    "start": "pnpm announce start && node --trace-warnings --trace-uncaught dist/server.js",
    "pretest": "pnpm announce pretest && pnpm eta:compile",
    "test": "pnpm announce test && vitest run --reporter=verbose",
    "test:watch": "pnpm announce test:watch && vitest --reporter=verbose",
    "lint": "pnpm announce lint && biome check --verbose --diagnostic-level=info --max-diagnostics=none --log-level=debug --log-kind=pretty .",
    "fmt": "pnpm announce fmt && biome check --write --verbose --diagnostic-level=info --max-diagnostics=none --log-level=debug --log-kind=pretty .",
    "pretypecheck": "pnpm announce pretypecheck && pnpm eta:compile",
    "typecheck": "pnpm announce typecheck && tsc --noEmit --pretty --extendedDiagnostics --listFiles --verbose",
    "check": "pnpm announce check && pnpm eta:compile && biome check --verbose --diagnostic-level=info --max-diagnostics=none --log-level=debug --log-kind=pretty . && pnpm typecheck && vitest run --reporter=verbose"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/formbody": "^9.0.0",
    "eta": "^4.6.0",
    "fastify": "5.12.3",
    "htmx.org": "^2.0.10",
    "koffi": "^3.2.1",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "yaml": "2.8.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/jsdom": "^30.0.0",
    "@types/node": "26.4.1",
    "@types/pg": "8.23.1",
    "jsdom": "^30.0.1",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  },
  "exports": {
    "./*": {
      "development": "./src/*",
      "default": "./dist/*"
    }
  }
}
