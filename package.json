{
  "name": "@config/src",
  "version": "0.1.0",
  "description": "Git-backed config registry for anudeep.pro — one place every service reads its configuration from",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24.20.0"
  },
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "dev": "tsx watch --conditions=development src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "fmt": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "check": "biome check . && tsc --noEmit && vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/formbody": "^9.0.0",
    "fastify": "5.12.3",
    "htmx.org": "^2.0.10",
    "koffi": "^3.2.1",
    "pino": "10.3.1",
    "yaml": "2.8.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/jsdom": "^30.0.0",
    "@types/node": "26.4.1",
    "jsdom": "^30.0.1",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  },
  "exports": {
    "./*": {
      "development": "./src/*",
      "default": "./dist/*"
    }
  }
}
